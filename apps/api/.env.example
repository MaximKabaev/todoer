# PostgreSQL connection string (required). Create the database/role before migrating.
DATABASE_URL=postgres://todoer:CHANGE_ME@127.0.0.1:5432/todoer

# Listening port (default 4000) and interface (default 127.0.0.1).
API_PORT=4000
API_HOST=127.0.0.1

# Required secret for hashing session IDs. Generate with: openssl rand -hex 32
# Rotating this invalidates all existing browser sessions.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Preferred direct base URL in GET /api/agent and /agent, even through the web proxy.
# Leave empty locally to derive the URL from the request protocol and Host header.
PUBLIC_API_URL=
# Production example: PUBLIC_API_URL=https://api.todo.customsai.org

# Secure session cookies when true OR NODE_ENV=production; otherwise off locally.
COOKIE_SECURE=false
NODE_ENV=development

# Absolute path recommended in production; default apps/api/uploads.
# Back this up together with the database.
API_UPLOAD_DIR=

# Optional isolated database schema for tests; leave unset for normal operation.
# Only lowercase letters, digits, underscores; must start with a letter/underscore.
API_DB_SCHEMA=

# First-time seed only: credentials/names may be overridden here.
# Passwords are generated and printed once when omitted; existing users are preserved.
# User 2 currently defaults to teammate / Teammate; set German explicitly for this app.
SEED_USER1_USERNAME=maxim
SEED_USER1_NAME=Maxim
SEED_USER1_PASSWORD=
SEED_USER2_USERNAME=german
SEED_USER2_NAME=German
SEED_USER2_PASSWORD=
